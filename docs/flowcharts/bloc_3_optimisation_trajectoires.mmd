    classDef process fill:#E8F1FB,stroke:#2F6690,color:#102A43;
    classDef decision fill:#FFF4CC,stroke:#B7791F,color:#5F370E;
    classDef output fill:#EDE9FE,stroke:#6B46C1,color:#322659;
    classDef error fill:#FDE8E8,stroke:#C53030,color:#63171B;
    class A,B input;
    class C,D,E,F,H,I,K,L,M,N,P,Q,R,T process;
    class G,J,O,S,U decision;
    class W,X output;
    class V error;
